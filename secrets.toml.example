# Authentication Configuration (OAuth)
# Copy this file to .streamlit/secrets.toml and fill in your values

[google]
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
redirect_uri = "http://localhost:8501/oauth/callback/google"

[github]
client_id = "YOUR_GITHUB_CLIENT_ID"
client_secret = "YOUR_GITHUB_CLIENT_SECRET"
redirect_uri = "http://localhost:8501/oauth/callback/github"

[microsoft]
client_id = "YOUR_MICROSOFT_CLIENT_ID"
client_secret = "YOUR_MICROSOFT_CLIENT_SECRET"
redirect_uri = "http://localhost:8501/oauth/callback/microsoft"
tenant_id = "common"

# Admin users (comma-separated emails)
ADMIN_EMAILS = "admin@example.com,other@institution.edu"

# Database
[database]
url = "sqlite:///./niklaus.db"
# For production, use PostgreSQL:
# url = "postgresql://user:pass@localhost/niklaus"

# Existing Maritaca config
[maritaca]
MARITACA_API_KEY = "your-api-key-here"
MARITACA_MODEL = "sabiazinho-4"